# Copy to .env for local development. Values here are for the local Docker database only.
ENVIRONMENT=development

# The app connects as supreme_app, which can't bypass row-level security.
DATABASE_URL=postgresql+psycopg://supreme_app:local-app-only@localhost:5433/supreme
# Migrations run as the owner of the tables.
MIGRATION_DATABASE_URL=postgresql+psycopg://supreme_owner:local-owner-only@localhost:5433/supreme

# Clients sign in at <slug>.<BASE_DOMAIN>; platform staff at <PLATFORM_SUBDOMAIN>.<BASE_DOMAIN>.
# Edge and Chrome send *.localhost to this machine, so supreme.localhost:5173 works without any set-up.
BASE_DOMAIN=localhost
PLATFORM_SUBDOMAIN=admin

SESSION_SECRET=change-me-to-a-long-random-value-0123456789
LOG_LEVEL=INFO

# First sign-in details created by "python -m app.seed" (you're asked to change the password at first sign-in).
SEED_PLATFORM_OWNER_EMAIL=owner@supremedms.local
SEED_PLATFORM_OWNER_PASSWORD=Change-me-now-1
