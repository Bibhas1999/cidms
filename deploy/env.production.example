# Production settings. deploy/make-env.ps1 fills the secrets in for you; keep the result (.env.production)
# out of git and off chat. The app refuses to start with development passwords or a weak SESSION_SECRET.
ENVIRONMENT=production
LOG_LEVEL=INFO

# The address: centres open at <slug>.<BASE_DOMAIN> (supreme.<BASE_DOMAIN>), the platform at admin.<BASE_DOMAIN>.
# Free option: a DuckDNS name such as cidms.duckdns.org (its sub-addresses all point at the same server).
BASE_DOMAIN=cidms.duckdns.org
PLATFORM_SUBDOMAIN=admin
# For Let's Encrypt (certificate expiry warnings only).
ACME_EMAIL=you@example.com

# Database passwords (random; make-env.ps1 makes them). The app connects as supreme_app (row-level security).
POSTGRES_OWNER_PASSWORD=__RANDOM__
POSTGRES_APP_PASSWORD=__RANDOM__
# Written out in full by make-env.ps1 (with the two passwords above in them).
DATABASE_URL=postgresql+psycopg://supreme_app:__APP_PASSWORD__@postgres:5432/supreme
MIGRATION_DATABASE_URL=postgresql+psycopg://supreme_owner:__OWNER_PASSWORD__@postgres:5432/supreme

# Signs nothing secret by itself but must be long and random.
SESSION_SECRET=__RANDOM__

# New staff and password resets get a random one-time password each (shown once to whoever made it).

# Email for password-reset links (Brevo free: 300/day). Leave SMTP_HOST empty to write links to the log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=CIDMS <no-reply@example.com>

# Medical images and WhatsApp are on hold: leave these off.
WHATSAPP_PROVIDER=

# ---------- monitoring ----------
# Who hears about a background job failing for good, the disk nearly full (under 10% free) or other alerts
# (comma-separated; uses the SMTP settings above). Empty: alerts are only written to the log.
ALERT_EMAIL=
# Unexpected errors from the app and the worker go to Sentry (free tier is enough). No personal data is sent.
SENTRY_DSN=
# Uptime: add an external check (e.g. UptimeRobot, free) on https://admin.<BASE_DOMAIN>/readyz every 5 minutes.

# ---------- security ----------
# Signs the links printed on reports (QR codes). Set it to the current SESSION_SECRET value before ever changing
# SESSION_SECRET, so printed reports keep working. Empty: SESSION_SECRET is used.
REPORT_LINK_SECRET=
# Request/response bodies encrypted between the browser and the app: optional | required | off.
# Switch to required once everyone is on the new version (older open tabs send plain JSON until reloaded).
PAYLOAD_ENCRYPTION=optional
